FlashLang Language Grammar v2.1
===============================

PROGRAM STRUCTURE
-----------------
program = ( import_declaration | package_declaration | statement )* ;


IMPORTS
-------
import_declaration = 
    | "import" , identifier , ";"
    | "import" , identifier , "." , identifier , ";"
    ;

package_declaration =
    "package" , identifier , ";" ;


STATEMENTS
----------
statement = 
    | variable_declaration
    | assignment
    | function_call
    | method_call
    | print_statement
    | return_statement
    | break_statement
    | continue_statement
    | throw_statement
    | if_statement
    | while_statement
    | for_statement
    | switch_statement
    | try_statement
    | class_declaration
    | function_declaration
    | decorator
    | python_block
    | py_call
    | expression_statement
    ;


DECORATORS
----------
decorator =
    "@" , identifier , newline? ;

decorated_function =
    decorator* , function_declaration ;

decorator_application =
    identifier , "(" , identifier , ")" ;


VARIABLES
---------
variable_declaration = 
    "var" , identifier , "=" , expression , ";" ;

assignment = 
    ( identifier | field_access | array_access ) , "=" , expression , ";" ;

field_access =
    expression , "." , identifier ;

array_access =
    expression , "[" , expression , "]" ;


OUTPUT
------
print_statement = 
    "print" , "(" , expression , ")" , ";" ;


INPUT
-----
input_statement =
    "input" , "(" , [ expression ] , ")" , ";" ;


CONTROL FLOW
------------
return_statement = 
    "return" , [ expression ] , ";" ;

break_statement = 
    "break" , ";" ;

continue_statement = 
    "continue" , ";" ;

throw_statement =
    "throw" , expression , ";" ;


CONDITIONALS
------------
if_statement = 
    "if" , "(" , expression , ")" , block ,
    [ "else" , "if" , "(" , expression , ")" , block ]* ,
    [ "else" , block ] ;


SWITCH
------
switch_statement =
    "switch" , "(" , expression , ")" , "{" ,
        ( case_clause | default_clause )* ,
    "}" ;

case_clause =
    "case" , expression , ":" , statement* , [ "break" , ";" ] ;

default_clause =
    "default" , ":" , statement* ;


TRY-CATCH
---------
try_statement =
    "try" , block ,
    "catch" , "(" , identifier , ")" , block ;


LOOPS
-----
while_statement = 
    "while" , "(" , expression , ")" , block ;

for_statement = 
    "for" , identifier , "in" , expression , block ;

for_range_statement =
    "for" , identifier , "in" , "range" , "(" , [ integer_literal , [ "," , integer_literal ] ] , ")" , block ;


CLASSES
-------
class_declaration =
    "class" , identifier , "{" ,
        ( field_declaration | constructor_declaration | method_declaration )* ,
    "}" ;

field_declaration =
    "var" , identifier , "=" , expression , ";" ;

constructor_declaration =
    "constructor" , "(" , [ parameters ] , ")" , block ;

method_declaration =
    decorator* , "func" , identifier , "(" , [ parameters ] , ")" , block ;


FUNCTIONS
---------
function_declaration = 
    decorator* , "func" , identifier , "(" , [ parameters ] , ")" , block ;

parameters = 
    identifier ( "," , identifier )* ;

function_call = 
    identifier , "(" , [ arguments ] , ")" ;

method_call = 
    expression , "." , identifier , "(" , [ arguments ] , ")" ;

arguments = 
    expression ( "," , expression )* ;


BLOCKS
------
block = 
    "{" , statement* , "}" ;


PYTHON INTEGRATION
------------------
python_block = 
    "python" , "{" , 
        ( python_code )* ,
    "}" ;

python_code = 
    ? any valid Python code ? ;

py_call = 
    "py:" , python_expression ;

python_expression =
    ? any valid Python expression ? ;


JSON SUPPORT
------------
json_parse =
    "json_parse" , "(" , expression , ")" ;

json_stringify =
    "json_stringify" , "(" , expression , ")" ;


EXPRESSIONS
-----------
expression = 
    | literal
    | identifier
    | field_access
    | array_access
    | function_call
    | method_call
    | object_creation
    | py_call
    | json_parse
    | json_stringify
    | binary_operation
    | unary_operation
    | "(" , expression , ")"
    ;

object_creation =
    "new" , identifier , "(" , [ arguments ] , ")" ;

binary_operation = 
    expression , operator , expression ;

operator = 
    "+" | "-" | "*" | "/" | "%" | 
    "==" | "!=" | "<" | ">" | "<=" | ">=" |
    "&&" | "||" | "and" | "or" ;

unary_operation = 
    ( "-" | "!" | "not" ) , expression ;

expression_statement = 
    expression , ";" ;


LITERALS
--------
literal = 
    | integer_literal
    | float_literal
    | string_literal
    | boolean_literal
    | null_literal
    | list_literal
    | dict_literal
    ;

integer_literal = 
    digit+ ;

float_literal = 
    digit+ , "." , digit+ ;

string_literal = 
    '"' , ( character - '"' )* , '"' |
    "'" , ( character - "'" )* , "'" ;

boolean_literal = 
    "true" | "false" ;

null_literal = 
    "null" ;

list_literal = 
    "[" , [ expression ( "," , expression )* ] , "]" ;

dict_literal = 
    "{" , [ expression , ":" , expression ( "," , expression , ":" , expression )* ] , "}" ;


COMMENTS
--------
single_line_comment = 
    "//" , ( character - newline )* , newline ;


IDENTIFIERS
-----------
identifier = 
    letter , ( letter | digit | "_" )* ;

letter = 
    "a".."z" | "A".."Z" | "_" ;

digit = 
    "0".."9" ;


KEYWORDS
--------
keywords = 
    "var" | "print" | "input" | "if" | "else" | "while" | "for" | "in" |
    "func" | "return" | "break" | "continue" | "throw" |
    "import" | "package" | "python" | "py" |
    "class" | "constructor" | "new" | "this" |
    "switch" | "case" | "default" |
    "try" | "catch" |
    "true" | "false" | "null" |
    "and" | "or" | "not" |
    "json_parse" | "json_stringify" ;


BUILT-IN FUNCTIONS
------------------
builtin_functions = 
    | "print"   - output to console
    | "input"   - read from console
    | "len"     - get length of string/list/dict
    | "range"   - generate sequence of numbers
    | "str"     - convert to string
    | "int"     - convert to integer
    | "float"   - convert to float
    | "list"    - convert to list
    | "dict"    - convert to dict
    | "type"    - get type of value
    | "json_parse"    - parse JSON string
    | "json_stringify" - convert to JSON string
    ;


BUILT-IN DECORATORS
-------------------
builtin_decorators =
    | "@log"        - log function calls
    | "@timer"      - measure execution time
    | "@deprecated" - mark as deprecated
    | "@memoize"    - cache results
    ;


PRECEDENCE TABLE
----------------
Precedence | Operators              | Associativity
-----------|------------------------|---------------
1          | () . [] new            | left
2          | - (unary) ! not        | right
3          | * / %                  | left
4          | + -                    | left
5          | < > <= >=              | left
6          | == !=                  | left
7          | && and                 | left
8          | || or                  | left
9          | =                      | right


EXAMPLES
--------
// Variable declaration
var name = "World";
var count = 42;
var pi = 3.14;

// Print
print("Hello, " + name);
print(count);

// Input
var user = input("Enter name: ");

// Conditional
if (count > 10) {
    print("Large number");
} else if (count > 5) {
    print("Medium number");
} else {
    print("Small number");
}

// While loop
var i = 0;
while (i < 5) {
    print(i);
    i = i + 1;
}

// For loop
for i in range(5) {
    print("Iteration: " + i);
}

// For loop over array
var items = [1, 2, 3, 4, 5];
for item in items {
    print(item);
}

// Function with decorators
@log
@timer
func add(a, b) {
    return a + b;
}

// Class with decorators
class Person {
    var name = "";
    
    constructor(name) {
        this.name = name;
    }
    
    @log
    func greet() {
        print("Hello, " + this.name);
    }
}

var person = new Person("Alice");
person.greet();

// Python call
var result = py: math.sqrt(16);
var doubled = py: [x*2 for x in [1,2,3]];

// Python block
python {
    def greet(name):
        return f"Hello, {name}!"
    
    import os
    import sys
}

var msg = greet("World");

// JSON
var data = {
    "name": "FlashLang",
    "version": 2.1
};
var json_str = json_stringify(data);
var parsed = json_parse(json_str);

// Import
import math;
import random;
import mymodule;

// Array operations
var arr = [10, 20, 30];
arr[1] = 99;
print(arr[0]);

// Switch
switch (x) {
    case 1:
        print("One");
        break;
    case 2:
        print("Two");
        break;
    default:
        print("Other");
}

// Try-catch
try {
    throw "Error!";
} catch (e) {
    print("Caught: " + e);
}